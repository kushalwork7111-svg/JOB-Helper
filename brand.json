{
  "version": "2026.10-1",
  "approved": false,
  "note": "Derived from BDO Brand & Visual Identity Guidelines 2023 (Basic Elements) and the BDO PowerPoint template 2023. See docs/BRAND_RULES.md. Awaiting owner approval.",
  "slide": { "widthPt": 960, "heightPt": 540 },
  "fonts": { "heading": "Trebuchet MS", "body": "Trebuchet MS", "allowed": ["Trebuchet MS"] },
  "title": { "leftPt": 38.3, "topPt": 46.8, "widthPt": 883.7, "heightPt": 28.4, "sizePt": 26, "bold": false,
             "color": "#E81A3B", "case": "sentence", "align": "Left", "tolerancePt": 4 },
  "subtitle": { "topPt": 75.1, "sizePt": 18, "color": "#333333" },
  "body": { "sizePt": 12, "minSizePt": 8, "color": "#333333", "lineSpacing": 1.0, "spaceAfterPt": 6, "align": "Left" },
  "palette": {
    "primary": ["#E81A3B", "#333333", "#5B6E7F", "#98002E", "#E7E7E7"],
    "secondary": ["#D67900", "#009966", "#008FD2"],
    "neutrals": ["#FFFFFF", "#000000", "#404040", "#666666", "#F2F2F2", "#ADADAD", "#0062B8"],
    "noTints": ["#E81A3B", "#98002E"]
  },
  "margins": { "leftPt": 38.3, "rightPt": 38.3, "topPt": 46.8, "bottomPt": 28.4 },
  "footer": { "topPt": 511.6, "sizePt": 8, "color": "#ADADAD", "requirePageNumber": true, "confidentialityText": "" },
  "keepWords": ["BDO", "EBITDA", "M&A", "DVCS", "CXO", "CEO", "CFO", "CHRO", "HR", "IT", "ESG", "IPO", "PMI", "PMO", "IMO", "JV",
                "SOW", "DD", "VDD", "HRDD", "TSA", "KPI", "KPIs", "INR", "USD", "PE", "VC", "PEVC", "MIS", "ERP", "SAP", "AI"],
  "leftoverPatterns": ["\\bX{2,}\\b", "\\[\\s*\\]", "\\[(?:insert|tbd|tbc|name|client|date)[^\\]]*\\]", "\\bTBD\\b", "\\bTBC\\b",
                       "\\blorem\\b", "click to (?:add|edit)", "\\bDRAFT\\b"],
  "terms": [
    { "label": "INR / Rs. before an amount → ₹", "find": "\\b(?:INR|Rs\\.?)\\s*(?=\\d)", "replace": "₹", "flags": "g" },
    { "label": "INR before a unit → ₹", "find": "\\bINR(?=\\s+(?:Cr|crores?|lakhs?)\\b)", "replace": "₹", "flags": "gi" },
    { "label": "crore / crores / crs → Cr", "find": "\\b(?:crores?|crs)\\b", "replace": "Cr", "flags": "gi" },
    { "label": "Cr. → Cr", "find": "\\bCr\\.(?=\\s+[a-z0-9₹(])", "replace": "Cr", "flags": "g" },
    { "label": "lakhs / lac / lacs → lakh", "find": "\\b(?:lakhs|lacs?)\\b", "replace": "lakh", "flags": "gi" }
  ]
}
